rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin','staff'];
    }
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Public site config: catalog, content, colors, settings, promos, categories, sections.
    // Anyone can read (so the storefront renders); only admins can change it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: a guest/customer may place one; only admins may read/update/delete.
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Roles/permissions. Only the owner (super_admin) may grant or change roles.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // User profiles.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Reviews: public read; anyone can submit (pending); admins moderate.
    match /reviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Newsletter signups: write-only for the public, admins read.
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
